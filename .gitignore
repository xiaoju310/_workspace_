# 忽略本地开发生成物，避免提交依赖、数据库、虚拟环境和密钥。
node_modules/
dist/
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
.env
.env.*
!.env.example
*.local
test-results/
data/
*.tsbuildinfo

# 本地运行产生的缓存和测试临时目录。
.tmp-pytest*/
*.egg-info/

.pytest-auth-temp/
.pytest-mongo-auth-temp/

# 2026-11-16 核心功能补充测试生成物（不含源码）
.tmp-workflow*/
.tmp-workflow*.py

# 桌面验收临时文件：源码、正式数据和手机版不在这些规则中。
/.tmp-*/
/.tmp-*.py
/.pytest_cache/
/.pytest-*-temp/
/paper-sync-browser-*/
/pytest-of-*/
# 私有备份始终建议放项目外；防止误复制后提交账号数据。
/private-backups/

# Python 工具脚本也会生成缓存。
__pycache__/

# Do not upload generated acceptance data, personal books or local test artifacts.
/backend/.pytest-*/
/backend/frame-longbook-*/
/backend/pdf-tests-*/
/backend/pdf-wrapup-*/
/backend/priority-tests-*/
/backend/qa-*/
/backend/system-check-*/
/backend/*tests.txt
/frontend-wonderland/*tests.txt
/frontend-wonderland/*build.txt
/frontend-wonderland/*results.txt
/mobile-tablet/test-books/
/汇报材料/_work/

# Publication boundary: operational/acceptance documents remain local.
/docs/*
!/docs/licenses/
!/docs/协作与审核规则.md
!/docs/public-release/
/docs/public-release/*
!/docs/public-release/software-update.md
!/docs/public-release/data-boundary.md
!/docs/public-release/third-party-models.md

