# 忽略本地开发生成物，避免提交依赖、数据库、虚拟环境和密钥。
node_modules/
dist/
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
.env
.env.*
!.env.example
*.local
test-results/
data/
*.tsbuildinfo

# 本地运行产生的缓存和测试临时目录。
.tmp-pytest*/
*.egg-info/

.pytest-auth-temp/
.pytest-mongo-auth-temp/

# Development caches, logs and local credentials (desktop release).
**/__pycache__/
.pytest*/
*.log
*.pem
*.key
*.p12
*.keystore
